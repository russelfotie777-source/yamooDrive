# Copier en .env et remplir. Ce fichier n'est jamais servi par Apache.

# Assistant : sans clé, l'assistant répond avec ses réponses intégrées (mots-clés).
ANTHROPIC_API_KEY=

# Paiement : « demo » simule MTN Mobile Money et Orange Money (aucun débit, un numéro
# qui finit par 000 simule un refus). « notchpay » encaisse pour de vrai via Notch Pay.
PAIEMENT_FOURNISSEUR=demo
NOTCHPAY_CLE_PUBLIQUE=
NOTCHPAY_HASH_WEBHOOK=

# Espace équipe (/equipe) : fermé tant que ce mot de passe est vide.
ADMIN_MOT_DE_PASSE=

APP_DEBUG=0
