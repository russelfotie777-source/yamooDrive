# Toutes les adresses passent par index.php, sauf les fichiers publics de assets/.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|src|vues|stockage|vendor)(/|$) - [F,L]
  RewriteRule ^(\.env.*|composer\.(json|lock)|README\.md)$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType image/avif .avif
AddType font/woff2 .woff2
